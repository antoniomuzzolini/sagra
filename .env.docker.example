# Production environment for the Docker deploy. Copy to `.env` and fill in.
# Generate secrets before the first `up` (see DEPLOY.md).

APP_NAME=Sagra
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Europe/Rome
APP_URL=https://your-domain.example

# Set this to your domain (e.g. sagra.example.com) on a VPS and Caddy provisions
# HTTPS automatically. Leave it EMPTY for a local trial (serves plain HTTP on
# http://localhost).
APP_DOMAIN=

# Containers log to the collector, not to files.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Database ---------------------------------------------------------------
# Local Postgres from docker-compose. For Neon, keep DB_CONNECTION=pgsql and
# either set DB_URL to the Neon connection string, or fill DB_HOST/USERNAME/
# PASSWORD with the Neon values (SSL is negotiated automatically).
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=sagra
DB_USERNAME=sagra
DB_PASSWORD=please-change-me
# DB_URL=postgresql://user:pass@host/db?sslmode=require

# --- Everything on Postgres (no Redis needed) -------------------------------
SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Web push (VAPID) -------------------------------------------------------
# Generate once: docker compose run --rm app php artisan webpush:vapid
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Self-hosting at home behind a Cloudflare Tunnel (optional) -------------
# Trust the tunnel so HTTPS / secure cookies are detected. Set to * when using
# the tunnel; leave empty on a VPS where FrankenPHP terminates TLS directly.
TRUSTED_PROXIES=
# Paste the token from your Cloudflare Tunnel, then start with:
#   docker compose --profile tunnel up -d --build
# (leave APP_DOMAIN empty so the app serves plain HTTP; the tunnel adds HTTPS)
CLOUDFLARE_TUNNEL_TOKEN=

# --- Mail (optional: service e-mail, e.g. magic-link recovery) --------------
MAIL_MAILER=log
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=no-reply@your-domain.example
